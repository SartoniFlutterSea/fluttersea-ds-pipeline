# Pubblica su GitHub Pages lo Storybook di documentazione.
#
# La repo è PUBBLICA, quindi il sito sarà pubblico: nessun piano Enterprise
# richiesto e nessun posto GitHub necessario per chi lo consulta. Se un
# giorno la repo diventasse privata, servirebbe Enterprise Cloud per tenere
# il sito accessibile ai soli membri dell'organizzazione.
#
# Da fare UNA VOLTA prima del primo run:
#   Settings → Pages → Source: GitHub Actions
#
# Le storie non sono in repo: si rigenerano qui dai metadata.json, che
# restano l'unica fonte.

name: Storybook

on:
  push:
    branches: [main]
    paths:
      - 'components/**/docs/metadata.json'
      - 'storybook/**'
      - '.storybook/**'
      - 'scripts/build-stories.mjs'
      - 'package.json'
      - '.github/workflows/storybook.yml'
  pull_request:
    paths:
      - 'components/**/docs/metadata.json'
      - 'storybook/**'
      - '.storybook/**'
  workflow_dispatch:

concurrency:
  group: storybook-${{ github.ref }}
  cancel-in-progress: true

permissions:
  contents: read

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: '22'
          cache: npm

      - run: npm ci

      # Rigenera le storie dai metadata.json e compila il sito statico.
      - run: npm run build-storybook

      - name: Prepara per Pages
        if: github.ref == 'refs/heads/main'
        uses: actions/upload-pages-artifact@v3
        with:
          path: storybook-static

      # Sulle PR il sito non si pubblica: resta scaricabile dal run, così si
      # può verificare che compili prima del merge.
      - name: Artefatto della PR
        if: github.event_name == 'pull_request'
        uses: actions/upload-artifact@v4
        with:
          name: storybook-pr-${{ github.event.number }}
          path: storybook-static
          retention-days: 7

  deploy:
    needs: build
    if: github.ref == 'refs/heads/main'
    runs-on: ubuntu-latest
    permissions:
      pages: write
      id-token: write
    environment:
      name: github-pages
      url: ${{ steps.deploy.outputs.page_url }}
    steps:
      - id: deploy
        uses: actions/deploy-pages@v4

# NOTA: questo file vive in docs/ e non in .github/workflows/ perche' il token
# usato per il primo push non aveva lo scope `workflow`. Per attivarlo:
#   gh auth refresh -h github.com -s workflow
#   git mv docs/storybook.yml.pending .github/workflows/storybook.yml
